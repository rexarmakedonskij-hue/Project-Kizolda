* text=auto

# Keep Unity and helper sources consistent across operating systems.
*.cfg text eol=lf
*.py text eol=lf
*.md text eol=lf

# Editable models and runtime binary assets are stored in Git LFS.
*.blend filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
