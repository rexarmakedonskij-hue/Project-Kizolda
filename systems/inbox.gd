extends RefCounted

const LETTERS := [
	{"subject": "Отчёт к встрече", "sender": "Марина • руководитель проекта", "body": "Встречу перенесли на 15:00. Пришли мне отчёт за август до 14:00. Июльские цифры уже есть, повторно отправлять их не нужно.", "options": ["Отправить отчёт за август до 14:00", "Отправить отчёт за июль до 14:00", "Отправить отчёт за август после встречи"], "answer": "Отправить отчёт за август до 14:00", "hint": "Проверь месяц отчёта и время отправки."},
	{"subject": "Кому отправить макет?", "sender": "Илья • дизайнер", "body": "Макет готов, но сначала его должна проверить Оля. Клиенту пока ничего не отправляй: правки ещё возможны.", "options": ["Отправить макет Оле на проверку", "Отправить макет сразу клиенту", "Архивировать письмо без ответа"], "answer": "Отправить макет Оле на проверку", "hint": "Нужна внутренняя проверка перед отправкой клиенту."},
	{"subject": "Перенос созвона", "sender": "Оля • редактор", "body": "Во вторник я занята. Перенеси наш созвон на среду, 11:00. Участников и ссылку оставь прежними.", "options": ["Среда, 11:00; прежняя ссылка", "Вторник, 11:00; прежняя ссылка", "Среда, 15:00; новая ссылка"], "answer": "Среда, 11:00; прежняя ссылка", "hint": "Сверь день, время и ссылку."},
	{"subject": "Нужен доступ", "sender": "Саша • новый сотрудник", "body": "Не могу открыть папку проекта. Мне нужно только читать документы, редактировать их не планирую. Оформи минимально необходимый доступ.", "options": ["Запросить доступ на чтение", "Запросить права администратора", "Запросить доступ на редактирование"], "answer": "Запросить доступ на чтение", "hint": "Для чтения не нужны права на изменение документов."},
	{"subject": "Счёт с ошибкой", "sender": "Вера • бухгалтерия", "body": "В счёте указан старый адрес компании. Не передавай его на оплату. Попроси поставщика исправить адрес и прислать новый счёт.", "options": ["Запросить исправленный счёт у поставщика", "Передать старый счёт на оплату", "Изменить сумму и отправить на оплату"], "answer": "Запросить исправленный счёт у поставщика", "hint": "Сначала нужен корректный документ от поставщика."},
	{"subject": "Какая версия окончательная?", "sender": "Денис • аналитик", "body": "В папке два файла: budget_draft и budget_final. Для презентации используй budget_final. Черновик оставь в папке, он ещё понадобится.", "options": ["Взять budget_final, сохранить черновик", "Взять budget_draft, удалить итоговый файл", "Взять budget_final, удалить черновик"], "answer": "Взять budget_final, сохранить черновик", "hint": "Нужна итоговая версия, но удалять черновик не просили."}
]
var order: Array = []
var index := -1
var current: Dictionary = {}
var selected := -1
var resolved := false
var feedback := "Выбери действие по письму и нажми «Отправить»."

func _init() -> void:
	order = range(LETTERS.size())
	order.shuffle()
	next_email()

func next_email() -> void:
	index += 1
	current = LETTERS[order[index % order.size()]].duplicate(true)
	current.options.shuffle()
	selected = -1
	resolved = false
	feedback = "Выбери действие по письму и нажми «Отправить»."

func choose(option: int) -> void:
	if resolved or option < 0 or option >= current.options.size(): return
	selected = option
	feedback = "Действие выбрано. Можно отправлять."

func submit() -> bool:
	if resolved: return false
	if selected < 0:
		feedback = "Сначала выбери действие."
		return false
	if current.options[selected] != current.answer:
		feedback = "Проверь ответ: " + current.hint
		return false
	resolved = true
	feedback = "Письмо обработано. Результат сохранён."
	return true
